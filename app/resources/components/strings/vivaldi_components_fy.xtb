<?xml version="1.0" encoding="utf-8" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="fy">
<translation id="3830627370375585318">Vivaldi tastean tagong ta jo netwurk yn jo brânmuorre of antyfirus te brûken.</translation>
<translation id="4932161901409251843">Gean nei
          it Vivaldi menu &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="ADVANCED_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          en soargje derfoar dat de konfiguraasje ynsteld is op "gjin proksy" of "rjochtstreeks."</translation>
<translation id="4949828774841497663">Gean nei Apps &gt; Systeemynstellingen &gt; Netwurk en selektearje it aktive netwurk. Klik op de knop Details... knop en ûntselekearje alle proksies dy't miskien selektearre binne.</translation>
<translation id="5248344925342018662">Jo besjogge in feilige Vivaldi side</translation>
<translation id="6690242244468452299">Dizze side lit ynformaasje sjen oer de lêste ferûngelokjes as jo it ferûngelok rappotaasje ynskeakele hawwe.</translation>
<translation id="7023871570427738255">Gean nei
          it Vivaldi menu &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="ADVANCED_TITLE" />
          en set "<ph name="NO_PREFETCH_DESCRIPTION" /> út."
          As dit net de swierrigens oplost, riede wie oan dizze opsje wer te selektearjen
          foar ferbettere prestaasjes.</translation>
<translation id="7496505986576158197">Vivaldi is mooglik makke troch <ph name="BEGIN_LINK_CHROMIUM" />Chromium<ph name="END_LINK_CHROMIUM" /> iepen boarne projek en oare <ph name="BEGIN_LINK_OSS" />iepen boarne sofware<ph name="END_LINK_OSS" />.</translation>
<translation id="89559930087159128">Gean nei
          it Vivaldi menu &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="SYSTEM_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          &gt;
          Netwurk &amp; ynternet &gt; Proksy
          en skeakelje "ynstellingen automatysk ûntdekke" ût.</translation>
</translationbundle>
