update_target("//chrome/browser:browser") {
  sources += [
    "//vivaldi/browser/menus/vivaldi_menu_enums.h",
    "//vivaldi/browser/shell_integration/vivaldi_shell_integration.h",
    "//vivaldi/browser/vivaldi_net_error_tab_helper.cc",
